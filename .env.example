# Every variable the app reads. Placeholder values only — real ones live in
# /etc/tracker/.env on the VPS. Copy to .env.local for local development.

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/tracking_crm

# ── Public URLs ──────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL=https://shiptrack.store
# Origin the chat widget snippet points at (falls back to the current page's origin)
NEXT_PUBLIC_WIDGET_ORIGIN=https://shiptrack.store
# Base for customer tracking links when a panel has no tracking domain
TRACKING_BASE_URL=https://shiptrack.store

# ── Super-admin login ────────────────────────────────────────
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Signs login tokens (src/lib/auth.ts). At least 32 random characters, e.g.
# `openssl rand -hex 32`. Without it nobody can log in. Changing it signs
# everyone out.
AUTH_TOKEN_SECRET=

# ── Refund form (src/lib/refund/crypto.ts) ───────────────────
# 32 random bytes, base64 (`openssl rand -base64 32`), created ON the server, never printed.
# Encrypts the UPI / bank details customers give in the refund form. Without it the form is
# switched off (fail closed). Back it up: if it is lost, stored details cannot be read.
# Never derived from AUTH_TOKEN_SECRET (changing that signs everyone out; it must not lock refunds).
REFUND_DATA_KEY=
# Only while rotating the key (scripts/refund-rekey.js): the previous key.
REFUND_DATA_KEY_OLD=
# "off" = the refund form is closed for customers and Send is off (the panel stays readable).
REFUND_FORMS=

# ── Cron secrets (must match the VPS crontab URLs) ───────────
# ?key=    on progress-orders, pending-emails, draft-queue
DRAFT_QUEUE_SECRET=
# ?secret= on chat-email-poll, send-queued-email.
# Set it: when unset the code falls back to a default that is public in this repo.
CRON_SECRET=

# ── AI (OpenRouter) ──────────────────────────────────────────
CODEX_URL=https://openrouter.ai/api
AI_API_KEY=
# Optional; defaults to the first model in FALLBACK_CHAIN (src/lib/chat/ai.ts)
AI_MODEL=
# Optional; the cheap model the side tasks try first (health score, subject line, team score check,
# learner, suggested replies / Sudharo). Defaults to deepseek/deepseek-v4-flash (src/lib/chat/ai-models.ts).
AI_SIDE_MODEL=

# ── Order status emails ──────────────────────────────────────
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_SCRIPT_URL=

# ── Shopify app ──────────────────────────────────────────────
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# ── Chargeback WhatsApp alert (optional; src/lib/chargeback/notify.ts) ───────────────────
# WhatsApp Cloud API (Meta). Create ONE approved message template with 3 variables (panel, gateway, order),
# e.g. "Chargeback alert: {{1}} got a chargeback mail from {{2}} for order {{3}}." Nothing is sent until all three exist.
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_CHARGEBACK_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=
# WhatsApp in Chat Support (src/lib/chat/whatsapp.ts): the webhook's verify token, the Meta app secret that
# signs every webhook call (set it before real customers), the Graph API base (default v25.0) and the
# panel the WhatsApp chats belong to (default: the default panel).
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_BASE=
WHATSAPP_PANEL_ID=
# The WhatsApp Business Account id (templates); Settings > WhatsApp can hold it instead.
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Where the Mail tab keeps its copy of each Gmail on disk (src/lib/chat/mail-cache.ts); default <app>/.mail-cache; 'off' = memory only
MAIL_CACHE_DIR=
