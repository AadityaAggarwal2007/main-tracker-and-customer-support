# Every variable the app reads. Placeholder values only — real ones live in
# /etc/tracker/.env on the VPS. Copy to .env.local for local development.

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/tracking_crm

# ── Public URLs ──────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL=https://shiptrack.store
# Origin the chat widget snippet points at (falls back to the current page's origin)
NEXT_PUBLIC_WIDGET_ORIGIN=https://shiptrack.store
# Base for customer tracking links when a panel has no tracking domain
TRACKING_BASE_URL=https://shiptrack.store

# ── Super-admin login ────────────────────────────────────────
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ── Cron secrets (must match the VPS crontab URLs) ───────────
# ?key=    on progress-orders, pending-emails, draft-queue
DRAFT_QUEUE_SECRET=
# ?secret= on chat-email-poll, send-queued-email.
# Set it: when unset the code falls back to a default that is public in this repo.
CRON_SECRET=

# ── AI (OpenRouter) ──────────────────────────────────────────
CODEX_URL=https://openrouter.ai/api
AI_API_KEY=
# Optional; defaults to the first model in FALLBACK_CHAIN (src/lib/chat/ai.ts)
AI_MODEL=

# ── Order status emails ──────────────────────────────────────
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_SCRIPT_URL=

# ── Shopify app ──────────────────────────────────────────────
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
