spawn ssh -o StrictHostKeyChecking=no root@200.141.13.66
expect "password:"
send "akx#.2F0khYvfXpi\r"
expect "# "
send "sudo -u postgres psql -d tracking_crm -c \"SELECT b.id, b.name, b.tracking_domain, b.is_shopify_connected, b.shopify_webhook_id, COUNT(o.id) AS order_count FROM businesses b LEFT JOIN orders o ON o.business_id = b.id GROUP BY b.id, b.name, b.tracking_domain, b.is_shopify_connected, b.shopify_webhook_id ORDER BY order_count DESC;\"\r"
expect "# "
